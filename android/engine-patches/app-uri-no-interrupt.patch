+  onDestroy() {
+    if (this._cyphraClosing) {
+      return;
+    }
+    this._cyphraClosing = true;
+
+    try {
+      const browser = this.browser;
+      if (!browser?.isRemoteBrowser || !browser.frameLoader?.remoteTab) {
+        return;
+      }
+
+      // Closing abandons this document, including any pending download response.
+      // Use its normal per-tab epoch before the browser is torn down.
+      // about:blank is cancellation metadata; this never loads a document.
+      browser.webNavigation.maybeCancelContentJSExecution(
+        Ci.nsIRemoteTab.NAVIGATE_URL,
+        { uri: Services.io.newURI("about:blank") }
+      );
+    } catch {
+      // A remote tab may already be gone. Continue closing every module.
